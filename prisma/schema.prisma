generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./mamt.db"
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  role     String // Admin, Supervisor, Planner, Mechanic, Viewer
}

model Asset {
  id                Int        @id @default(autoincrement())
  assetNo           String     @unique
  assetType         String
  assetClass        String?
  manufacturer      String
  model             String
  serialNo          String?
  commissionDate    DateTime?
  location          String     // "Site > Area > Zone"
  smuUom            String     // "hours" | "km"
  startUsage        Float
  annualUsage       Float
  criticality       String
  fleet             String
  parentId          Int?
  parent            Asset?     @relation("ChildAssets", fields: [parentId], references: [id])
  children          Asset[]    @relation("ChildAssets")
  workOrders        WorkOrder[]
  components        Component[]
  createdAt         DateTime   @default(now())
}

model WorkOrder {
  id            Int       @id @default(autoincrement())
  assetId       Int
  asset         Asset     @relation(fields: [assetId], references: [id])
  title         String
  dueDate       DateTime
  startDate     DateTime?
  endDate       DateTime?
  status        String    // Planned, InProgress, Completed, Cancelled
  downtimeType  String?   // Breakdown, Planned, Standby
  labourHours   Float
  partsCost     Float
  miscCost      Float
  notes         String?
  attachments   Attachment[]
  createdAt     DateTime  @default(now())
}

model Component {
  id           Int       @id @default(autoincrement())
  assetId      Int
  asset        Asset     @relation(fields: [assetId], references: [id])
  partCode     String
  serialNo     String?   // For rotables
  installDate  DateTime
  removeDate   DateTime?
  lifeHours    Float
  isRotable    Boolean   @default(false)
  repairStages RotableStage[]
}

model RotableStage {
  id          Int       @id @default(autoincrement())
  componentId Int
  component   Component @relation(fields: [componentId], references: [id])
  stage       String    // "InTransit", "Repair", "Test", "Ready"
  location    String
  updatedAt   DateTime  @updatedAt
}

model Attachment {
  id        Int       @id @default(autoincrement())
  woId      Int?
  assetId   Int?
  fileName  String
  path      String
  mimeType  String
  createdAt DateTime  @default(now())
}
